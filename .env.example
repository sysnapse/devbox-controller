# devbox controller — environment
#
# Easiest path: run ./setup.sh once. It fills this file in (generates a token,
# sets an absolute work root, reads DOCKER_GID off /var/run/docker.sock) and
# fixes ownership of the work root. Everything below can also be set by hand.
#
# Required: >=16 characters. Generate with: openssl rand -hex 32
DCA_TOKEN=

# Required: host work directory (mounted at the same path; devbox /workspace binds here)
# Note: the controller runs as a non-root uid (default 1000) and cannot chown a host dir.
# That directory must be owned by, or writable to, that uid.
#   DCA_HOST_WORK_ROOT=/home/<user>/workspaces/dca/work
# setup.sh creates it and fixes permissions.
DCA_HOST_WORK_ROOT=

# Required: gid of the host docker group, so the dca user can use /var/run/docker.sock
# Read it with: stat -c %g /var/run/docker.sock (setup.sh fills it in)
DOCKER_GID=

# Optional
# Controller bind address and port. Default 0.0.0.0 (an agent on a bridge connects
# through the gateway IP). Auth is the token alone; 127.0.0.1 for host-only.
DCA_BIND=0.0.0.0
DCA_PORT=47123
# Devbox network: empty = no --network flag (docker default bridge)
DCA_NETWORK=
DCA_OWNER=agent
DCA_EXEC_TIMEOUT=900
DCA_IDLE_HOURS=0
DCA_ALLOW_TAGS=0
DCA_ALLOW_PRIVATE_URL=0

# Optional: git credentials for clone/push, host side only. The token never enters
# a devbox and never lands in .git/config. Fine-grained PAT with contents:write.
# DCA_GIT_TOKEN=
# DCA_GIT_USER=x-access-token

# Optional: uid/gid inside the controller. Must match the user in templates/*.yml,
# or cloned files are not writable in the devbox.
# DCA_UID=1000
# DCA_GID=1000
