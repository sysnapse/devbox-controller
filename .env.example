# devbox controller — environment
#
# Easiest path: run ./setup.sh once. It fills this file in (generates a token,
# sets an absolute work root, reads DOCKER_GID off /var/run/docker.sock) and
# fixes ownership of the work root. Everything below can also be set by hand.
#
# 必填：>=16 字符。生成方式：openssl rand -hex 32
DCA_TOKEN=

# 必填：宿主工作目录（controller 内以同一路径挂载，devbox 的 /workspace 由此 bind）
# 注意：controller 以非 root uid（默认 1000）运行，无法 chown 宿主目录。
# 该目录必须由 uid 1000 拥有，或本身可写。最简单的做法是留在 repo 内：
#   DCA_HOST_WORK_ROOT=/home/<user>/workspaces/dca/work
# setup.sh 会自动建好并处理权限。
DCA_HOST_WORK_ROOT=

# 必填：宿主 docker 组的 gid，让 controller 内的 dca 用户能读写 /var/run/docker.sock
# 取得方式：stat -c %g /var/run/docker.sock（setup.sh 会自动填）
DOCKER_GID=

# 可选
# controller 绑定地址与端口。默认 0.0.0.0（agent 在 bridge 时靠网关 IP 连入），
# 认证完全靠 token；想只给 host 网络用就改 127.0.0.1
DCA_BIND=0.0.0.0
DCA_PORT=47123
# devbox 的网络：留空 = 不传 --network（docker 默认 bridge）
DCA_NETWORK=
DCA_OWNER=agent
DCA_EXEC_TIMEOUT=900
DCA_IDLE_HOURS=0
DCA_ALLOW_TAGS=0
DCA_ALLOW_PRIVATE_URL=0

# 可选：controller 容器内 uid/gid。必须与 templates/*.tpl 的 user 一致，
# 否则 clone 出来的文件在 devbox 内改不动。改这个要同时 build-arg 到 image。
# DCA_UID=1000
# DCA_GID=1000
